{
  "name": "timetree-worklog-mcp",
  "version": "0.1.0",
  "description": "Local-first MCP server for daily work logs with optional, safety-gated TimeTree memo publishing.",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "timetree-worklog-mcp": "dist/index.js"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/set-executable.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run tests/e2e",
    "test:live": "tsx tests/live/live-smoke.ts",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "verify": "npm run typecheck && npm run lint && npm run format && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.0.3",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "22.20.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "prettier": "3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "better-sqlite3@13.0.3": true,
    "fsevents@2.3.3": true
  }
}
