# timetree-worklog-mcp environment example
#
# The server reads environment variables from the MCP client or the shell.
# It does NOT load this file automatically. Use it as a reference only.
# Never commit real credentials. Prefer an OS keychain or secret injection.

# Local data
WORKLOG_TIMEZONE=Africa/Accra
# WORKLOG_DATA_DIR=/absolute/path/to/private/timetree-worklog-data
# WORKLOG_DB_PATH=/absolute/path/to/private/timetree-worklog-data/worklog.sqlite
# WORKLOG_ARCHIVE_DIR=/absolute/path/to/private/timetree-worklog-data/worklogs
# WORKLOG_REPORTS_DIR=/absolute/path/to/private/timetree-worklog-data/reports
WORKLOG_LOG_LEVEL=info

# Provider: "mock" for safe local evaluation, "community" for the optional
# unofficial TimeTree web client.
TIMETREE_PROVIDER=mock
TIMETREE_CALENDAR_ID=cal_worklog

# Remote writes are disabled by default. Leave false until the operator has
# reviewed the project and explicitly authorized a remote write.
TIMETREE_ENABLE_REMOTE_WRITES=false

# Conservative limits
TIMETREE_MAX_RPS=1
TIMETREE_TIMEOUT_MS=20000
TIMETREE_MAX_RETRIES=3
TIMETREE_REMOTE_MAX_CHARS=20000
TIMETREE_MAX_RESPONSE_BYTES=2000000

# Community provider only. Do not put real credentials in a committed file.
# TIMETREE_BASE_URL=https://timetreeapp.com
# TIMETREE_EMAIL=operator@example.com
# TIMETREE_PASSWORD=use-a-secret-store
# Alternative auth for accounts that sign in with Google and have no password:
# paste the _session_id cookie from an authenticated browser session. This is a
# bearer credential, it expires, and it takes precedence over email/password.
# Treat it like a password and never commit it.
# TIMETREE_SESSION_COOKIE=paste-the-_session_id-value
